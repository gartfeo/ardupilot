<?xml version="1.0"?>

<!-- MasterAirScrew Electric 13x8.5 Propeller -->
<!-- Pusher configuration -->
<!--
     Inputs:
       diameter:     13 inches
       pitch:        8.5 inches (fixed)
       power:        ~1700W

     Flight validated:
       Static thrust: 5-6 kg (stated)
       Cruise: 24.5 m/s at 68% throttle
-->

<propeller name="MAS_13x8.5">
  <ixx> 0.0012 </ixx>
  <diameter unit="IN"> 13.0 </diameter>
  <numblades> 2 </numblades>
  <minpitch> 8.5 </minpitch>
  <maxpitch> 8.5 </maxpitch>

  <!-- Thrust coefficient table vs advance ratio (J = V / nD) -->
  <!-- Scaled to match 5-6 kg static thrust with 1700W motor -->
  <table name="C_THRUST" type="internal">
    <tableData>
      0.0  0.115
      0.1  0.108
      0.2  0.100
      0.3  0.090
      0.4  0.078
      0.5  0.062
      0.6  0.045
      0.7  0.028
      0.8  0.010
      0.9 -0.010
      1.0 -0.030
    </tableData>
  </table>

  <!-- Power coefficient table vs advance ratio -->
  <table name="C_POWER" type = "internal">
    <tableData>
      0.0  0.065
      0.1  0.064
      0.2  0.062
      0.3  0.058
      0.4  0.052
      0.5  0.044
      0.6  0.035
      0.7  0.025
      0.8  0.015
      0.9  0.005
      1.0 -0.010
    </tableData>
  </table>

</propeller>
