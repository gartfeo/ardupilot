 FLIGHTGEAR INTERFACE - UDP communication for visualization
 =====================================================================
 -->
 <output name="localhost" type="FLIGHTGEAR" port="5503" protocol="udp" rate="10"/>
 <input port="5505"/>

</fdm_config>
