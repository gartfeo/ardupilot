      <function name="aero/moment/yaw_control">
        <description>Yaw control from split-elevon drag (effective)</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <property>fcs/yaw-effective-rad</property>
          <value>0.025</value>
        </product>
      </function>

      <function name="aero/moment/yaw_aileron">
        <description>Adverse yaw from aileron (effective)</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <property>fcs/aileron-effective-rad</property>
          <value>-0.004</value>
        </product>
      </function>
    </axis>

  </aerodynamics>

  <!-- ============================================================= -->
  <!-- FLIGHTGEAR INTERFACE                                          -->
  <!-- ============================================================= -->
  <output name="localhost" type="FLIGHTGEAR" port="5503" protocol="udp" rate="10"/>
  <input port="5505"/>

</fdm_config>
