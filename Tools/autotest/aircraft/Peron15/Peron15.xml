 GROUND REACTIONS - 3-point belly landing contacts
 =====================================================================
 Catapult launched UAV - contacts for belly landing/crash only
 Triangle: NOSE(5.9,0) - LEFT_WING(39.4,-30.3) - RIGHT_WING(39.4,+30.3)
 CG at (25.22, 0) is inside triangle for stability
 -->
 <ground_reactions>
   <!-- Forward nose contact (belly landing) -->
   <contact type="STRUCTURE" name="NOSE">
    <location unit="IN">
      <x>  5.9  </x>
      <y>  0.0  </y>
      <z> -2.5  </z>
    </location>
    <static_friction>  0.80 </static_friction>
    <dynamic_friction> 0.50 </dynamic_friction>
    <spring_coeff unit="LBS/FT"> 600 </spring_coeff>
    <damping_coeff unit="LBS/FT/SEC"> 120 </damping_coeff>
   </contact>

   <!-- Left wingtip trailing edge contact (belly landing) -->
   <contact type="STRUCTURE" name="LEFT_WING">
    <location unit="IN">
      <x> 39.4  </x>
      <y>-30.3  </y>
      <z> -2.5  </z>
    </location>
    <static_friction>  0.80 </static_friction>
    <dynamic_friction> 0.50 </dynamic_friction>
    <spring_coeff unit="LBS/FT"> 600 </spring_coeff>
    <damping_coeff unit="LBS/FT/SEC"> 120 </damping_coeff>
   </contact>

   <!-- Right wingtip trailing edge contact (belly landing) -->
   <contact type="STRUCTURE" name="RIGHT_WING">
    <location unit="IN">
      <x> 39.4  </x>
      <y> 30.3  </y>
      <z> -2.5  </z>
    </location>
    <static_friction>  0.80 </static_friction>
    <dynamic_friction> 0.50 </dynamic_friction>
    <spring_coeff unit="LBS/FT"> 600 </spring_coeff>
    <damping_coeff unit="LBS/FT/SEC"> 120 </damping_coeff>
