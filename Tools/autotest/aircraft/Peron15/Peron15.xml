<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sourceforge.net/JSBSim.xsl"?>
<fdm_config name="Peron15" version="2.0" release="ALPHA"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:noNamespaceSchemaLocation="http://jsbsim.sourceforge.net/JSBSim.xsd">

  <fileheader>
    <author>Generated for ArduPilot SITL</author>
    <filecreationdate>2025-01-13</filecreationdate>
    <version>1.1</version>
    <description>
      Peron15 Delta Wing UAV - Similar to Zala Aero Kub
      Catapult launched, belly landing capable

      Geometry:
      Length:      1238 mm (48.7 in)
      Wingspan:    1540 mm (60.6 in)
      Wing Area:   7779.5 cm2 (8.37 ft2)
      MAC:         607.8 mm (23.93 in)
      Wing LE:     250 mm from nose

      Mass:
      Weight:      7.46 kg (16.45 lbs)
      CG:          640.7 mm from nose (25.22 in)
      Ixx/Iyy/Izz: 0.239 / 0.534 / 0.766 slug-ft2

      Propulsion:
      Motor: T-MOTOR AT4130 KV450 (1700W)
      Prop:  MAS 13x8.5 pusher
      Battery: 2x 8S3P Molicel P45B (28.8V, 778Wh)

      Notes:
      Pure flying wing - no vertical surfaces
      Yaw control via split-elevon differential drag

      IMPORTANT:
      Ensure engine file "AT4130_KV450.xml" and prop "MAS_13x8p5.xml"
      exist in your JSBSim engine/prop directories.
    </description>
  </fileheader>

  <!-- ============================================================= -->
  <!-- METRICS                                                       -->
  <!-- ============================================================= -->
  <metrics>
    <wingarea unit="FT2"> 8.37 </wingarea>
    <wingspan unit="FT"> 5.05 </wingspan>
    <wing_incidence unit="DEG"> 0.0 </wing_incidence>
    <chord unit="FT"> 1.994 </chord>

    <location name="AERORP" unit="IN">
      <x>25.22</x><y>0.0</y><z>0.0</z>
    </location>

    <location name="EYEPOINT" unit="IN">
      <x>12.0</x><y>0.0</y><z>3.0</z>
    </location>

    <location name="VRP" unit="IN">
      <x>0.0</x><y>0.0</y><z>0.0</z>
    </location>
  </metrics>

  <!-- ============================================================= -->
  <!-- MASS BALANCE                                                  -->
  <!-- ============================================================= -->
  <mass_balance>
    <ixx unit="SLUG*FT2"> 0.239 </ixx>
    <iyy unit="SLUG*FT2"> 0.534 </iyy>
    <izz unit="SLUG*FT2"> 0.766 </izz>
    <ixy unit="SLUG*FT2"> 0.0 </ixy>
    <ixz unit="SLUG*FT2"> 0.0 </ixz>
    <iyz unit="SLUG*FT2"> 0.0 </iyz>
    <emptywt unit="LBS"> 16.45 </emptywt>

    <location name="CG" unit="IN">
      <x>25.22</x><y>0.0</y><z>0.0</z>
    </location>
  </mass_balance>

  <!-- ============================================================= -->
  <!-- GROUND REACTIONS (belly landing contacts)                      -->
  <!-- Soft springs + high damping for stable ground behavior         -->
  <!-- ============================================================= -->
  <ground_reactions>
    <contact type="STRUCTURE" name="NOSE">
      <location unit="IN"><x>5.9</x><y>0.0</y><z>-2.0</z></location>
      <static_friction>0.80</static_friction>
      <dynamic_friction>0.50</dynamic_friction>
      <spring_coeff unit="LBS/FT">150</spring_coeff>
      <damping_coeff unit="LBS/FT/SEC">50</damping_coeff>
    </contact>

    <contact type="STRUCTURE" name="LEFT_WING">
      <location unit="IN"><x>39.4</x><y>-30.3</y><z>-3.0</z></location>
      <static_friction>0.80</static_friction>
      <dynamic_friction>0.50</dynamic_friction>
      <spring_coeff unit="LBS/FT">150</spring_coeff>
      <damping_coeff unit="LBS/FT/SEC">50</damping_coeff>
    </contact>

    <contact type="STRUCTURE" name="RIGHT_WING">
      <location unit="IN"><x>39.4</x><y>30.3</y><z>-3.0</z></location>
      <static_friction>0.80</static_friction>
      <dynamic_friction>0.50</dynamic_friction>
      <spring_coeff unit="LBS/FT">150</spring_coeff>
      <damping_coeff unit="LBS/FT/SEC">50</damping_coeff>
    </contact>
  </ground_reactions>

  <!-- ============================================================= -->
  <!-- PROPULSION                                                    -->
  <!-- ============================================================= -->
  <propulsion>
    <engine file="AT4130_KV450">
      <location unit="IN"><x>47.24</x><y>0.0</y><z>0.0</z></location>
      <orient unit="DEG"><pitch>0</pitch><roll>0</roll><yaw>0</yaw></orient>
      <feed>0</feed>
      <thruster file="MAS_13x8p5">
        <location unit="IN"><x>48.74</x><y>0.0</y><z>0.0</z></location>
        <orient unit="DEG"><pitch>0</pitch><roll>0</roll><yaw>180</yaw></orient>
      </thruster>
    </engine>

    <!-- Battery represented as fuel tank (mass tracking placeholder) -->
    <tank type="FUEL" number="0">
      <location unit="IN"><x>25.0</x><y>0.0</y><z>0.0</z></location>
      <capacity unit="LBS">0.0</capacity>
      <contents unit="LBS">0.0</contents>
    </tank>
  </propulsion>

  <!-- ============================================================= -->
  <!-- FLIGHT CONTROL (single channel, Rascal-style evaluation order) -->
  <!-- ============================================================= -->
  <flight_control name="FCS: Peron15">

    <channel name="All">

      <!-- ===== 1) TRIM SUMS (normalized) ===== -->
      <summer name="Pitch Trim Sum">
        <input>fcs/elevator-cmd-norm</input>
        <input>fcs/pitch-trim-cmd-norm</input>
        <clipto><min>-1</min><max>1</max></clipto>
      </summer>

      <summer name="Roll Trim Sum">
        <input>fcs/aileron-cmd-norm</input>
        <input>fcs/roll-trim-cmd-norm</input>
        <clipto><min>-1</min><max>1</max></clipto>
      </summer>

      <summer name="Yaw Trim Sum">
        <input>fcs/rudder-cmd-norm</input>
        <input>fcs/yaw-trim-cmd-norm</input>
        <clipto><min>-1</min><max>1</max></clipto>
      </summer>

      <!-- ===== 2) SCALE TO RADIANS ===== -->
      <aerosurface_scale name="Elevator Control">
        <input>fcs/pitch-trim-sum</input>
        <range><min>-0.35</min><max>0.35</max></range>
        <output>fcs/elevator-pos-rad</output>
      </aerosurface_scale>

      <aerosurface_scale name="Aileron Control">
        <input>fcs/roll-trim-sum</input>
        <range><min>-0.35</min><max>0.35</max></range>
        <output>fcs/aileron-pos-rad</output>
      </aerosurface_scale>

      <!-- Split-elevon yaw contribution (radians) -->
      <aerosurface_scale name="Yaw Elevon Control">
        <input>fcs/yaw-trim-sum</input>
        <range><min>-0.20</min><max>0.20</max></range>
        <output>fcs/yaw-elevon-rad</output>
      </aerosurface_scale>

      <!-- ===== 3) MIX ELEVONS (clamped) ===== -->
      <!-- Left elevon = elevator + aileron - yaw -->
      <fcs_function name="Left Elevon Pos Rad">
        <function>
          <min>
            <max>
              <sum>
                <property>fcs/elevator-pos-rad</property>
                <property>fcs/aileron-pos-rad</property>
                <property>-fcs/yaw-elevon-rad</property>
              </sum>
              <value>-0.52</value>
            </max>
            <value>0.52</value>
          </min>
        </function>
      </fcs_function>

      <!-- Right elevon = elevator - aileron + yaw -->
      <fcs_function name="Right Elevon Pos Rad">
        <function>
          <min>
            <max>
              <sum>
                <property>fcs/elevator-pos-rad</property>
                <property>-fcs/aileron-pos-rad</property>
                <property>fcs/yaw-elevon-rad</property>
              </sum>
              <value>-0.52</value>
            </max>
            <value>0.52</value>
          </min>
        </function>
      </fcs_function>

      <!-- ===== 4) NO-YAW ELEVONS (for pitch/roll effectiveness without yaw leakage) ===== -->
      <fcs_function name="Left Elevon No Yaw">
        <function>
          <min>
            <max>
              <sum>
                <property>fcs/elevator-pos-rad</property>
                <property>fcs/aileron-pos-rad</property>
              </sum>
              <value>-0.52</value>
            </max>
            <value>0.52</value>
          </min>
        </function>
      </fcs_function>

      <fcs_function name="Right Elevon No Yaw">
        <function>
          <min>
            <max>
              <difference>
                <property>fcs/elevator-pos-rad</property>
                <property>fcs/aileron-pos-rad</property>
              </difference>
              <value>-0.52</value>
            </max>
            <value>0.52</value>
          </min>
        </function>
      </fcs_function>

      <!-- ===== 5) EFFECTIVE VALUES (after saturation) ===== -->
      <!-- yaw-effective-rad = average achieved yaw contribution after elevon saturation -->
      <fcs_function name="Yaw Effective Rad">
        <function>
          <product>
            <sum>
              <difference>
                <property>fcs/left-elevon-no-yaw</property>
                <property>fcs/left-elevon-pos-rad</property>
              </difference>
              <difference>
                <property>fcs/right-elevon-pos-rad</property>
                <property>fcs/right-elevon-no-yaw</property>
              </difference>
            </sum>
            <value>0.5</value>
          </product>
        </function>
      </fcs_function>

      <!-- elevator-effective-rad = (left_no_yaw + right_no_yaw)/2 -->
      <fcs_function name="Elevator Effective Rad">
        <function>
          <product>
            <sum>
              <property>fcs/left-elevon-no-yaw</property>
              <property>fcs/right-elevon-no-yaw</property>
            </sum>
            <value>0.5</value>
          </product>
        </function>
      </fcs_function>

      <!-- aileron-effective-rad = (left_no_yaw - right_no_yaw)/2 -->
      <fcs_function name="Aileron Effective Rad">
        <function>
          <product>
            <difference>
              <property>fcs/left-elevon-no-yaw</property>
              <property>fcs/right-elevon-no-yaw</property>
            </difference>
            <value>0.5</value>
          </product>
        </function>
      </fcs_function>

      <!-- ===== 6) THROTTLE (0..1) ===== -->
      <aerosurface_scale name="Throttle">
        <input>fcs/throttle-cmd-norm</input>
        <zero_centered>false</zero_centered>
        <domain><min>0</min><max>1</max></domain>
        <range><min>0</min><max>1</max></range>
        <output>fcs/throttle-pos-norm[0]</output>
      </aerosurface_scale>

      <!-- ===== 7) NORMALIZED OUTPUTS (ArduPilot compatibility) ===== -->
      <aerosurface_scale name="Elevator Normalized">
        <input>fcs/elevator-pos-rad</input>
        <domain><min>-0.35</min><max>0.35</max></domain>
        <range><min>-1</min><max>1</max></range>
        <output>fcs/elevator-pos-norm</output>
      </aerosurface_scale>

      <aerosurface_scale name="Left Elevon Normalized">
        <input>fcs/left-elevon-pos-rad</input>
        <domain><min>-0.52</min><max>0.52</max></domain>
        <range><min>-1</min><max>1</max></range>
        <output>fcs/left-aileron-pos-norm</output>
      </aerosurface_scale>

      <aerosurface_scale name="Right Elevon Normalized">
        <input>fcs/right-elevon-pos-rad</input>
        <domain><min>-0.52</min><max>0.52</max></domain>
        <range><min>-1</min><max>1</max></range>
        <output>fcs/right-aileron-pos-norm</output>
      </aerosurface_scale>

      <!-- No physical rudder; map yaw command for ArduPilot interface/logging -->
      <aerosurface_scale name="Yaw Command Normalized">
        <input>fcs/yaw-elevon-rad</input>
        <domain><min>-0.20</min><max>0.20</max></domain>
        <range><min>-1</min><max>1</max></range>
        <output>fcs/rudder-pos-norm</output>
      </aerosurface_scale>

    </channel>
  </flight_control>

  <!-- ============================================================= -->
  <!-- AERODYNAMICS (CFD-based, with guard points)                    -->
  <!-- NOTE: Cm table is scaled down to allow trim with given limits. -->
  <!-- ============================================================= -->
  <aerodynamics>

    <axis name="DRAG">
      <function name="aero/force/drag_basic">
        <description>Drag vs alpha (guard points)</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <table>
            <independentVar>aero/alpha-deg</independentVar>
            <tableData>
              -30.0  0.50
              -25.0  0.35
              -20.0  0.22
              -10.0  0.06
              -5.0  0.0247
              -2.5  0.0140
              0.0  0.0107
              2.5  0.0118
              5.0  0.0202
              7.5  0.0356
              10.0  0.0674
              12.5  0.0984
              15.0  0.1357
              20.0  0.22
              25.0  0.35
              30.0  0.50
            </tableData>
          </table>
        </product>
      </function>

      <function name="aero/force/drag_beta">
        <description>Drag due to sideslip</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <abs><property>aero/beta-rad</property></abs>
          <value>0.15</value>
        </product>
      </function>

      <function name="aero/force/drag_left_elevon">
        <description>Drag due to left elevon deflection (no yaw)</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <abs><property>fcs/left-elevon-no-yaw</property></abs>
          <value>0.02</value>
        </product>
      </function>

      <function name="aero/force/drag_right_elevon">
        <description>Drag due to right elevon deflection (no yaw)</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <abs><property>fcs/right-elevon-no-yaw</property></abs>
          <value>0.02</value>
        </product>
      </function>

      <function name="aero/force/drag_yaw">
        <description>Additional drag from split-elevon yaw</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <abs><property>fcs/yaw-effective-rad</property></abs>
          <value>0.04</value>
        </product>
      </function>
    </axis>

    <axis name="SIDE">
      <function name="aero/force/side_beta">
        <description>Side force due to sideslip</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>aero/beta-rad</property>
          <value>-0.12</value>
        </product>
      </function>
    </axis>

    <axis name="LIFT">
      <function name="aero/force/lift_basic">
        <description>Lift vs alpha (guard points)</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <table>
            <independentVar>aero/alpha-deg</independentVar>
            <tableData>
              -30.0  -0.40
              -25.0  -0.50
              -20.0  -0.45
              -10.0  -0.35
              -5.0  -0.2348
              -2.5  -0.1043
              0.0   0.0187
              2.5   0.1654
              5.0   0.3093
              7.5   0.4433
              10.0   0.5069
              12.5   0.5740
              15.0   0.6546
              20.0   0.65
              25.0   0.55
              30.0   0.45
            </tableData>
          </table>
        </product>
      </function>

      <function name="aero/force/lift_elevon">
        <description>Lift due to symmetric elevon (uses effective elevator)</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>fcs/elevator-effective-rad</property>
          <value>0.175</value>
        </product>
      </function>
    </axis>

    <axis name="ROLL">
      <function name="aero/moment/roll_beta">
        <description>Roll moment due to sideslip</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <property>aero/beta-rad</property>
          <value>-0.08</value>
        </product>
      </function>

      <function name="aero/moment/roll_p">
        <description>Roll damping</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <property>aero/bi2vel</property>
          <property>velocities/p-aero-rad_sec</property>
          <value>-0.45</value>
        </product>
      </function>

      <function name="aero/moment/roll_r">
        <description>Roll due to yaw rate</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <property>aero/bi2vel</property>
          <property>velocities/r-aero-rad_sec</property>
          <value>0.08</value>
        </product>
      </function>

      <function name="aero/moment/roll_aileron">
        <description>Roll control from aileron (effective)</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <property>fcs/aileron-effective-rad</property>
          <value>0.075</value>
        </product>
      </function>

      <function name="aero/moment/roll_yaw_coupling">
        <description>Roll coupling from yaw drag asymmetry</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <property>fcs/yaw-effective-rad</property>
          <value>0.008</value>
        </product>
      </function>
    </axis>

    <axis name="PITCH">
      <!-- Cm table scaled down (~0.25x) so trim is feasible with +/-0.35 rad elevator -->
