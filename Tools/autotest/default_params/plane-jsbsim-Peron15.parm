# Peron15 Delta Wing UAV - JSBSim SITL Parameters
# Flying wing with elevon control and split-elevon yaw

# Airspeed settings for Peron15 (cruise 24 m/s)
AIRSPEED_CRUISE 24
AIRSPEED_MAX    35
AIRSPEED_MIN    15
ARSPD_USE       1

# Pitch limits for delta wing
PTCH_LIM_MIN_DEG -45
PTCH_LIM_MAX_DEG 25
ROLL_LIMIT_DEG   50

# Throttle settings
TRIM_THROTTLE   45
THR_MAX         100

# Flying wing elevon mixing
# SERVO1 = Left elevon, SERVO2 = Right elevon
SERVO1_FUNCTION 77
SERVO2_FUNCTION 78
SERVO3_FUNCTION 70

# Elevon differential for better roll performance (optional)
MIXING_DIFF     0

# KFF_RDDRMIX for rudder-to-aileron (yaw coordination)
# Flying wing with split-elevon yaw may need adjustment
KFF_RDDRMIX     0.2

# Control rate limits
RLL2SRV_RMAX    75
PTCH2SRV_RMAX_DN 60
PTCH2SRV_RMAX_UP 60

# Basic tuning starting point for delta wing
RLL2SRV_TCONST  0.4
RLL_RATE_P      0.2
RLL_RATE_I      0.15
RLL_RATE_D      0.01
RLL_RATE_FF     0.3

PTCH2SRV_TCONST 0.4
PTCH_RATE_P     0.12
PTCH_RATE_I     0.08
PTCH_RATE_D     0.005
PTCH_RATE_FF    0.4

# Navigation
NAVL1_PERIOD    12
WP_LOITER_RAD   60
WP_RADIUS       40

# Landing
LAND_DISARMDELAY 3
LAND_PITCH_DEG  2
LAND_FLARE_SEC  2

# Flight modes
FLTMODE1        10
FLTMODE2        11
FLTMODE3        12
FLTMODE4        5
FLTMODE5        2
FLTMODE6        0
FLTMODE_CH      8

# RC input settings
RC1_MAX         2000
RC1_MIN         1000
RC1_TRIM        1500
RC2_MAX         2000
RC2_MIN         1000
RC2_TRIM        1500
RC3_MAX         2000
RC3_MIN         1000
RC3_TRIM        1000
RC4_MAX         2000
RC4_MIN         1000
RC4_TRIM        1500

# Servo output settings
SERVO1_MIN      1000
SERVO1_MAX      2000
SERVO1_TRIM     1500
SERVO2_MIN      1000
SERVO2_MAX      2000
SERVO2_TRIM     1500
SERVO3_MIN      1000
SERVO3_MAX      2000

# EKF and logging
EK2_ENABLE      1
LOG_BITMASK     65535

# Battery monitor
BATT_MONITOR    4

# INS calibration offsets (required for SITL)
INS_ACCOFFS_X   0.001
INS_ACCOFFS_Y   0.001
INS_ACCOFFS_Z   0.001
INS_ACCSCAL_X   1.001
INS_ACCSCAL_Y   1.001
INS_ACCSCAL_Z   1.001
INS_ACC2OFFS_X  0.001
INS_ACC2OFFS_Y  0.001
INS_ACC2OFFS_Z  0.001
INS_ACC2SCAL_X  1.001
INS_ACC2SCAL_Y  1.001
INS_ACC2SCAL_Z  1.001
INS_GYR_CAL     0
